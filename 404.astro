---
import Base from '../layouts/Base.astro';
import { alternativas, textos, url } from '../lib/i18n';
const t = textos('es');
---
<Base lang="es" titulo={t.meta.noEncontrada.titulo} descripcion={t.meta.noEncontrada.descripcion} alternativas={alternativas('inicio')} noindex>
  <section class="contenedor seccion" style="display:grid;gap:1.75rem;min-height:60svh;align-content:center">
    <p class="etiqueta">404</p>
    <h1 class="display">{t.noEncontrada.titulo}</h1>
    <p class="bajada">{t.noEncontrada.texto}</p>
    <a class="boton" style="justify-self:start" href={url('es', 'inicio')}>{t.noEncontrada.volver}</a>
  </section>
</Base>
