---
import Base from '../layouts/Base.astro';
import Medio from '../components/Medio.astro';
import Titulo from '../components/Titulo.astro';
import FormConsulta from '../components/FormConsulta.astro';
import Icono from '../components/Icono.astro';
import { modulos } from '../content/modulos';
import { imagen } from '../lib/medios';
import { alternativas, fmt, m2, parrafos, textos, tr, url, whatsapp } from '../lib/i18n';
import type { Idioma, Modulo } from '../lib/tipos';

interface Props { lang: Idioma; modulo: Modulo }
const { lang, modulo: m } = Astro.props;
const t = textos(lang);
const f = t.ficha;
const nombre = tr(m.nombre, lang);
const otro = modulos.find((x) => x.slug !== m.slug)!;
const wa = whatsapp(fmt(t.contacto.wa.modulo, { modulo: nombre }));
const especificaciones = m.especificaciones.filter((e) => e.confirmado);
const materiales = m.materiales.filter((e) => e.confirmado);
const categorias = [
  ['exterior', f.exterior, m.medios.exterior],
  ['interior', f.interior, m.medios.interior],
  ['detalles', f.detalles, m.medios.detalles],
] as const;
const portadaImg = imagen(m.medios.portada);
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: nombre,
    category: tr(m.categoria, lang),
    description: tr(m.seo.descripcion, lang),
    brand: { '@type': 'Brand', name: 'TRAZOFINO ARQUITECTURA' },
    ...(portadaImg ? { image: new URL(portadaImg.src, Astro.site).href } : {}),
    additionalProperty: [{ '@type': 'PropertyValue', name: f.superficie, value: m.superficie, unitCode: 'MTK' }],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TRAZOFINO', item: new URL(url(lang, 'inicio'), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: t.nav.modulos, item: new URL(url(lang, 'modulos'), Astro.site).href },
      { '@type': 'ListItem', position: 3, name: nombre },
    ],
  },
];
const marcadores = (cat: string) => Array.from({ length: cat === 'exterior' ? 3 : 2 });
---
<Base
  lang={lang}
  titulo={tr(m.seo.titulo, lang)}
  descripcion={tr(m.seo.descripcion, lang)}
  alternativas={alternativas('modulos', m.slug)}
  actual="modulos"
  sobreHero
  imagenOg={portadaImg?.src}
  jsonld={jsonld}
  mensajeWa={fmt(t.contacto.wa.modulo, { modulo: nombre })}
  anclaCotizar="#consulta"
>
  <!-- Portada a pantalla completa -->
  <section class="ficha-hero" aria-labelledby="ficha-titulo">
    <div class="hero__medio">
      <Medio medio={m.medios.portada} lang={lang} ratio="libre" rotulo={`${nombre} · ${f.exterior}`} tono="oscuro" prioridad sizes="100vw" class="medio--lleno" />
    </div>
    <div class="contenedor ficha-hero__in">
      <div style="display:grid;gap:1.5rem">
        <nav class="migas" aria-label="Breadcrumb">
          <a href={url(lang, 'inicio')}>TRAZOFINO</a><span aria-hidden="true">/</span>
          <a href={url(lang, 'modulos')}>{t.nav.modulos}</a><span aria-hidden="true">/</span>
          <span aria-current="page">{nombre}</span>
        </nav>
        <Titulo nivel={1} texto={nombre} class="display" id="ficha-titulo" />
        <p class="etiqueta" style="color:var(--arena)" data-revelar>{tr(m.categoria, lang)}</p>
        <div class="botones" data-revelar style="--d:2">
          <a class="boton boton--claro" href="#consulta">{t.cta.cotizar}</a>
          {wa && <a class="boton boton--linea-claro" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" /> {t.cta.whatsapp}</a>}
        </div>
      </div>
      <p class="ficha-hero__m2" data-revelar style="--d:3" aria-label={`${f.superficie}: ${m2(m.superficie, lang)}`}>{m.superficie}<small>m²</small></p>
    </div>
  </section>

  <!-- Descripción y datos confirmados -->
  <section class="seccion">
    <div class="contenedor reticula ficha-intro">
      <div class="ficha-intro__texto" style="display:grid;gap:2rem">
        <p class="etiqueta" data-revelar>{nombre}</p>
        <Titulo texto={tr(m.resumen, lang)} class="titulo-1" />
        <div class="prosa secundario" data-revelar>{parrafos(tr(m.descripcion, lang)).map((p) => <p>{p}</p>)}</div>
      </div>
      <aside class="ficha-intro__datos" data-revelar style="--d:2">
        <dl class="datos">
          <div><dt>{f.superficie}</dt><dd class="cifra">{m2(m.superficie, lang)}</dd></div>
          <div><dt>{f.categoria}</dt><dd>{tr(m.categoria, lang)}</dd></div>
          {especificaciones.slice(0, 3).map((e) => <div><dt>{tr(e.etiqueta, lang)}</dt><dd>{tr(e.valor, lang)}</dd></div>)}
        </dl>
        <div class="ficha-acciones">
          <a class="boton boton--ancho" href="#consulta">{t.cta.cotizar}</a>
          {wa && <a class="boton boton--linea boton--ancho" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" /> {t.cta.whatsapp}</a>}
        </div>
      </aside>
    </div>
  </section>

  <!-- Galería por categoría -->
  <section class="seccion seccion--blanca" aria-labelledby="galeria-titulo">
    <div class="contenedor">
      <div class="encabezado">
        <h2 class="titulo-1" id="galeria-titulo" data-revelar>{f.galeria}</h2>
      </div>
      <div class="galeria" data-galeria>
        <div class="pestanas" role="tablist" aria-label={f.galeria}>
          {categorias.map(([id, label], n) => (
            <button type="button" role="tab" id={`tab-${id}`} aria-controls={`panel-${id}`} aria-selected={n === 0 ? 'true' : 'false'} tabindex={n === 0 ? 0 : -1}>{label}</button>
          ))}
        </div>
        {categorias.map(([id, label, items], n) => (
          <div class="galeria__panel" role="tabpanel" id={`panel-${id}`} aria-labelledby={`tab-${id}`} hidden={n !== 0} data-panel>
            {items.length ? (
              <>
                <div class="galeria__escena">
                  {items.map((md, k) => (
                    <div data-item hidden={k !== 0}>
                      <Medio medio={md} lang={lang} ratio="16x9" rotulo={`${nombre} · ${label}`} sizes="(min-width: 1480px) 1320px, 100vw" />
                    </div>
                  ))}
                </div>
                {items.length > 1 && (
                  <div class="galeria__barra">
                    <span class="etiqueta etiqueta--sola" data-contador>1 / {items.length}</span>
                    <div class="flechas">
                      <button class="flecha-btn" type="button" data-ant aria-label={f.anterior}><Icono nombre="flecha-izq" /></button>
                      <button class="flecha-btn" type="button" data-sig aria-label={f.siguiente}><Icono nombre="flecha" /></button>
                    </div>
                  </div>
                )}
              </>
            ) : (
              <>
                <div class="reticula" style="row-gap:1rem">
                  {marcadores(id).map((_, k) => (
                    <div class={k === 0 ? 'col-todo' : 'col-mitad'}>
                      <Medio medio={null} lang={lang} ratio={k === 0 ? '21x9' : '3x2'} rotulo={`${nombre} · ${label} 0${k + 1}`} tono={k % 2 ? 'piedra' : 'arena'} />
                    </div>
                  ))}
                </div>
                <p class="secundario" style="margin-top:1.25rem;font-size:var(--t-sm)">{f.galeriaPendiente}</p>
              </>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Plano, especificaciones, materiales, personalización -->
  <section class="seccion">
    <div class="contenedor bloques-ficha">
      <div class="bloque" data-revelar>
        <h2 class="titulo-2">{f.plano}</h2>
        {m.plano ? (
          <Medio medio={m.plano} lang={lang} ratio="libre" rotulo={`${nombre} · ${f.plano}`} sizes="(min-width: 1024px) 45vw, 100vw" />
        ) : (
          <>
            <Medio medio={null} lang={lang} ratio="1x1" rotulo={`${nombre} · ${f.plano}`} tono="arena" />
            <p class="pendiente">{f.planoPendiente}</p>
          </>
        )}
      </div>
      <div style="display:grid;gap:clamp(3rem,2rem + 2vw,4rem);align-content:start">
        <div class="bloque" data-revelar>
          <h2 class="titulo-2">{f.especificaciones}</h2>
          {especificaciones.length ? (
            <table class="tabla"><tbody>{especificaciones.map((e) => <tr><th scope="row">{tr(e.etiqueta, lang)}</th><td>{tr(e.valor, lang)}</td></tr>)}</tbody></table>
          ) : (
            <p class="pendiente">{f.especificacionesPendiente}</p>
          )}
        </div>
        <div class="bloque" data-revelar>
          <h2 class="titulo-2">{f.materiales}</h2>
          {materiales.length ? (
            <table class="tabla"><tbody>{materiales.map((e) => <tr><th scope="row">{tr(e.etiqueta, lang)}</th><td>{tr(e.valor, lang)}</td></tr>)}</tbody></table>
          ) : (
            <p class="pendiente">{f.materialesPendiente}</p>
          )}
        </div>
        {m.personalizacion.length > 0 && (
          <div class="bloque" data-revelar>
            <h2 class="titulo-2">{f.personalizacion}</h2>
            <p class="secundario">{f.personalizacionTexto}</p>
            <ul class="lista-opciones">
              {m.personalizacion.map((o) => (
                <li><span>{tr(o.nombre, lang)}</span>{o.estado === 'pendiente' && <span class="distintivo">{t.aviso.aConfirmar}</span>}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Consulta contextual -->
  <section class="seccion seccion--oscura" id="consulta" aria-labelledby="consulta-titulo">
    <div class="contenedor consulta">
      <div style="display:grid;gap:1.5rem;align-content:start">
        <p class="etiqueta">{f.consultaEtiqueta}</p>
        <h2 class="titulo-1" id="consulta-titulo">{fmt(f.consultaTitulo, { modulo: nombre })}</h2>
        <p class="bajada">{f.consultaTexto}</p>
      </div>
      <div class="panel-claro"><FormConsulta lang={lang} modulo={m.slug} id={`form-${m.slug}`} /></div>
    </div>
  </section>

  <!-- Acceso al otro modelo -->
  <section class="seccion" aria-labelledby="otro-titulo">
    <div class="contenedor otro-modulo">
      <a href={url(lang, 'modulos', otro.slug)} class="pieza__medio" aria-hidden="true" tabindex="-1">
        <Medio medio={otro.medios.portada} lang={lang} ratio="3x2" rotulo={`${tr(otro.nombre, lang)} · ${f.exterior}`} tono="piedra" barrido sizes="(min-width: 1024px) 55vw, 100vw" />
      </a>
      <div style="display:grid;gap:1.5rem" data-revelar>
        <p class="etiqueta">{f.otroModulo}</p>
        <h2 class="titulo-1" id="otro-titulo"><a href={url(lang, 'modulos', otro.slug)}>{tr(otro.nombre, lang)}</a></h2>
        <p class="cifra" style="font-size:var(--t-xl);color:var(--madera-oscura)">{m2(otro.superficie, lang)}</p>
        <p class="bajada">{tr(otro.resumen, lang)}</p>
        <div class="botones">
          <a class="boton" href={url(lang, 'modulos', otro.slug)}>{t.cta.verModulo}</a>
          <a class="boton boton--linea" href={`${url(lang, 'modulos')}#comparar`}>{t.cta.comparar}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-galeria]').forEach((g) => {
    const tabs = [...g.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const paneles = [...g.querySelectorAll<HTMLElement>('[data-panel]')];
    const activar = (i: number, foco = false) => {
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', String(k === i));
        t.tabIndex = k === i ? 0 : -1;
        paneles[k].hidden = k !== i;
      });
      if (foco) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => activar(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') activar((i + 1) % tabs.length, true);
        if (e.key === 'ArrowLeft') activar((i - 1 + tabs.length) % tabs.length, true);
      });
    });

    paneles.forEach((p) => {
      const items = [...p.querySelectorAll<HTMLElement>('[data-item]')];
      if (items.length < 2) return;
      const contador = p.querySelector<HTMLElement>('[data-contador]');
      let actual = 0;
      const ir = (n: number) => {
        const siguiente = (n + items.length) % items.length;
        const medio = items[actual].querySelector('.medio');
        medio?.classList.add('cambiando');
        setTimeout(() => {
          items[actual].hidden = true;
          medio?.classList.remove('cambiando');
          actual = siguiente;
          items[actual].hidden = false;
          if (contador) contador.textContent = `${actual + 1} / ${items.length}`;
        }, matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 250);
      };
      p.querySelector('[data-ant]')?.addEventListener('click', () => ir(actual - 1));
      p.querySelector('[data-sig]')?.addEventListener('click', () => ir(actual + 1));
      let x0 = 0;
      p.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
      p.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - x0;
        if (Math.abs(dx) > 50) ir(actual + (dx < 0 ? 1 : -1));
      });
    });
  });
</script>
