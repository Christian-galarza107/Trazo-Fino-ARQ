---
/**
 * Home: primera experiencia web de TRAZOFINO (docs/TRAZOFINO_DESIGN_SPEC.md).
 * Orden definitivo (§3): Header · Hero · Tu hogar · Tres caminos · Catálogo · Proyectos ·
 * Servicios · Hablemos de tu proyecto · Footer (el header y el footer los pone Base).
 * Las imágenes sin estado "aprobado" en la biblioteca se muestran con <Provisorio>.
 */
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import IconoLinea from '../components/IconoLinea.astro';
import Provisorio from '../components/Provisorio.astro';
import VideoPortada from '../components/VideoPortada.astro';
import { home, lineas } from '../content/home';
import { modulos } from '../content/modulos';
import { portada } from '../content/portada';
import { esVertical, imagen } from '../lib/medios';
import { proyectosVisibles } from '../lib/proyectos';
import { alternativas, fmt, m2, textos, tr, url, whatsapp } from '../lib/i18n';
import type { Idioma } from '../lib/tipos';

interface Props { lang: Idioma }
const { lang } = Astro.props;
const t = textos(lang);
const h = home;
const wa = whatsapp(t.contacto.wa.saludo);
const obras = proyectosVisibles().filter((p) => p.portada);
const video = portada.video;
const enlacesCaminos = [url(lang, 'modulos'), url(lang, 'proyectos'), '#servicios'];
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: t.modulos.titulo,
    itemListElement: modulos.map((m, n) => ({ '@type': 'ListItem', position: n + 1, url: new URL(url(lang, 'modulos', m.slug), Astro.site).href, name: tr(m.nombre, lang) })),
  },
];
---
<Base lang={lang} titulo={t.meta.inicio.titulo} descripcion={t.meta.inicio.descripcion} alternativas={alternativas('inicio')} actual="inicio" jsonld={jsonld}>
  <!-- 2. Hero: Nuevas formas de habitar -->
  <section class="tf-hero" aria-labelledby="hero-titulo" data-hero>
    {/* Fondo audiovisual: el video de portada. Sin video, un marcador hasta tener la imagen aprobada. */}
    {video ? (
      <VideoPortada video={video} lang={lang} sinRotulo />
    ) : (
      <div class="tf-hero__fondo"><Provisorio codigo="TF-HER-01" lang={lang} tono="oscuro" /></div>
    )}
    <div class="tf-contenedor tf-hero__in">
      <p class="tf-sobre tf-sobre--claro">{tr(h.hero.etiqueta, lang)}</p>
      <h1 class="tf-hero__titulo" id="hero-titulo">{tr(h.hero.titulo, lang)}</h1>
      <p class="tf-hero__texto">{tr(h.hero.texto, lang)}</p>
      <div class="tf-botones">
        <a class="tf-btn tf-btn--claro" href={url(lang, 'modulos')}>{tr(h.hero.modulos, lang)}<IconoLinea nombre="flecha" /></a>
        <a class="tf-btn tf-btn--borde-claro" href={url(lang, 'proyectos')}>{tr(h.hero.proyectos, lang)}<IconoLinea nombre="flecha" /></a>
      </div>
    </div>
  </section>

  <!-- 3. Tu hogar, más cerca -->
  <section class="tf-hogar" aria-labelledby="hogar-titulo">
    <div class="tf-hogar__medio">
      <Provisorio codigo="TF-MOD-M-03" lang={lang} ratio="3 / 2" tono="oscuro" />
      <dl class="tf-hogar__datos">
        {modulos.map((m) => (
          <div><dt>{tr(m.nombre, lang)}</dt><dd>{m.superficie} m<sup>2</sup></dd></div>
        ))}
      </dl>
    </div>
    <div class="tf-contenedor tf-hogar__in">
      <div class="tf-hogar__texto" data-revelar>
        <p class="tf-sobre">{tr(h.hogar.etiqueta, lang)}</p>
        <h2 class="tf-titulo" id="hogar-titulo">{lineas(h.hogar.titulo, lang).map((l) => <span class="tf-linea">{l}</span>)}</h2>
        <p class="tf-cuerpo">{tr(h.hogar.texto, lang)}</p>
        <a class="tf-btn tf-btn--bronce" href={url(lang, 'modulos')}>{tr(h.hogar.boton, lang)}<IconoLinea nombre="flecha" /></a>
      </div>
    </div>
  </section>

  <!-- 4. Tres caminos. Una misma visión -->
  <section class="tf-seccion tf-seccion--claro" aria-labelledby="caminos-titulo">
    <div class="tf-contenedor">
      <header class="tf-encabezado" data-revelar>
        <div>
          <p class="tf-sobre">{tr(h.caminos.etiqueta, lang)}</p>
          <h2 class="tf-titulo" id="caminos-titulo">{tr(h.caminos.titulo, lang)}</h2>
        </div>
        <p class="tf-encabezado__texto">{tr(h.caminos.texto, lang)}</p>
      </header>
      <div class="tf-caminos">
        {h.caminos.items.map((c, n) => (
          <article class="tf-tarjeta tf-camino" data-revelar style={`--d:${n}`}>
            <Provisorio codigo={c.codigo} lang={lang} ratio="8 / 3" class="tf-tarjeta__medio" />
            <div class="tf-tarjeta__cuerpo">
              <span class="tf-numero">0{n + 1}</span>
              <h3 class="tf-tarjeta__titulo">{tr(c.titulo, lang)}</h3>
              <p class="tf-tarjeta__texto">{tr(c.texto, lang)}</p>
              <a class="tf-enlace" href={enlacesCaminos[n]}>{tr(c.enlace, lang)}<IconoLinea nombre="flecha" /></a>
            </div>
          </article>
        ))}
      </div>
      <ul class="tf-atributos" data-revelar>
        {h.caminos.atributos.map((a) => (
          <li>
            <IconoLinea nombre={a.icono as 'plano'} class="tf-icono" />
            <div><strong>{tr(a.titulo, lang)}</strong><span>{tr(a.texto, lang)}</span></div>
          </li>
        ))}
      </ul>
      <p class="tf-nota">{tr(h.caminos.nota, lang)}</p>
    </div>
  </section>

  <!-- 5. Catálogo: Diseño que se adapta a tu vida -->
  <section class="tf-seccion" aria-labelledby="catalogo-titulo">
    <div class="tf-contenedor">
      <header class="tf-encabezado" data-revelar>
        <div>
          <p class="tf-sobre">{tr(h.catalogo.etiqueta, lang)}</p>
          <h2 class="tf-titulo" id="catalogo-titulo">{lineas(h.catalogo.titulo, lang).map((l) => <span class="tf-linea">{l}</span>)}</h2>
        </div>
        <p class="tf-encabezado__texto">{tr(h.catalogo.texto, lang)}</p>
      </header>
      <div class="tf-catalogo">
        {modulos.map((m, n) => (
          <article class="tf-tarjeta tf-modulo" data-revelar style={`--d:${n}`}>
            <Provisorio codigo={`TF-MOD-${m.codigo}-01`} lang={lang} ratio="3 / 2" class="tf-tarjeta__medio" />
            <div class="tf-tarjeta__cuerpo">
              <h3 class="tf-modulo__nombre">{tr(m.nombre, lang)}</h3>
              <p class="tf-modulo__m2">{m.superficie} m<sup>2</sup></p>
              <ul class="tf-modulo__lista">
                {h.catalogo.items.map((it) => (
                  <li><IconoLinea nombre={it.icono as 'plano'} class="tf-icono" />{fmt(tr(it.texto, lang), { m2: m2(m.superficie, lang) })}</li>
                ))}
              </ul>
              <a class="tf-btn tf-btn--borde" href={url(lang, 'modulos', m.slug)}>{tr(h.catalogo.detalles, lang)}<IconoLinea nombre="flecha" /></a>
            </div>
          </article>
        ))}
        <aside class="tf-tarjeta tf-crecimiento" data-revelar style="--d:2" aria-labelledby="crecimiento-titulo">
          <h3 class="tf-crecimiento__titulo" id="crecimiento-titulo">{lineas(h.catalogo.crecimiento.titulo, lang).map((l) => <span class="tf-linea">{l}</span>)}</h3>
          <ul>
            {h.catalogo.crecimiento.items.map((it) => (
              <li><Provisorio codigo={it.codigo} lang={lang} ratio="3 / 1" class="tf-crecimiento__esquema" /><span>{tr(it.texto, lang)}</span></li>
            ))}
          </ul>
          <p class="tf-nota">{tr(h.catalogo.crecimiento.nota, lang)}</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- 6. Proyectos realizados -->
  <section class="tf-seccion" aria-labelledby="proyectos-titulo">
    <div class="tf-contenedor">
      <header class="tf-encabezado tf-encabezado--enlace" data-revelar>
        <div>
          <p class="tf-sobre">{tr(h.proyectos.etiqueta, lang)}</p>
          <h2 class="tf-titulo" id="proyectos-titulo">{tr(h.proyectos.titulo, lang)}</h2>
        </div>
        <a class="tf-enlace tf-enlace--fino" href={url(lang, 'proyectos')}>{tr(h.proyectos.todos, lang)}<IconoLinea nombre="flecha" /></a>
      </header>
      <div class="tf-carrusel" data-carrusel>
        <button type="button" class="tf-carrusel__flecha tf-carrusel__flecha--izq" data-mover="-1" aria-label={tr(h.proyectos.anterior, lang)}><IconoLinea nombre="flecha-izq" /></button>
        <ul class="tf-carrusel__pista" data-pista tabindex="0" aria-label={tr(h.proyectos.titulo, lang)}>
          {obras.map((p) => {
            const img = imagen(p.portada)!;
            const vertical = esVertical(p.portada);
            return (
              <li class="tf-obra">
                <a href={url(lang, 'proyectos', p.slug)}>
                  <span class:list={['tf-obra__medio', { 'tf-obra__medio--vertical': vertical }]}>
                    <Picture src={img} alt={tr(p.portada!.alt, lang)} formats={['avif', 'webp']} widths={[480, 800, 1200].filter((w) => w <= img.width)} sizes="(min-width: 1024px) 400px, (min-width: 768px) 46vw, 85vw" loading="lazy" decoding="async" />
                  </span>
                  <strong>{tr(p.titulo, lang)}</strong>
                  <span>{p.ubicacion ?? tr(p.categoria, lang)}</span>
                </a>
              </li>
            );
          })}
        </ul>
        <button type="button" class="tf-carrusel__flecha tf-carrusel__flecha--der" data-mover="1" aria-label={tr(h.proyectos.siguiente, lang)}><IconoLinea nombre="flecha" /></button>
      </div>
    </div>
  </section>

  <!-- 7. Servicios profesionales y gestiones -->
  <section class="tf-seccion" id="servicios" aria-labelledby="servicios-titulo">
    <div class="tf-contenedor">
      <header class="tf-encabezado" data-revelar>
        <div>
          <p class="tf-sobre">{tr(h.servicios.etiqueta, lang)}</p>
          <h2 class="tf-titulo" id="servicios-titulo">{lineas(h.servicios.titulo, lang).map((l) => <span class="tf-linea">{l}</span>)}</h2>
        </div>
        <p class="tf-encabezado__texto">{tr(h.servicios.texto, lang)}</p>
      </header>
      <div class="tf-servicios">
        {h.servicios.items.map((s, n) => (
          <article class="tf-tarjeta tf-servicio" data-revelar style={`--d:${n}`}>
            <IconoLinea nombre={s.icono as 'plano'} class="tf-servicio__icono" />
            <h3 class="tf-tarjeta__titulo">{tr(s.titulo, lang)}</h3>
            <p class="tf-tarjeta__texto">{tr(s.texto, lang)}</p>
          </article>
        ))}
      </div>
      <div class="tf-servicios__pie">
        <a class="tf-btn tf-btn--bronce" href={url(lang, 'contacto')}>{tr(h.servicios.boton, lang)}<IconoLinea nombre="flecha" /></a>
        <a class="tf-enlace tf-enlace--fino" href={url(lang, 'contacto')}>{tr(h.servicios.factibilidad, lang)}<IconoLinea nombre="flecha" /></a>
      </div>
    </div>
  </section>

  <!-- 8. Hablemos de tu proyecto -->
  <section class="tf-cierre" aria-labelledby="cierre-titulo">
    <Provisorio codigo="TF-CIE-01" lang={lang} tono="oscuro" class="tf-cierre__fondo" />
    <div class="tf-contenedor tf-cierre__in" data-revelar>
      <h2 class="tf-cierre__titulo" id="cierre-titulo">{tr(h.cierre.titulo, lang)}</h2>
      <p>{tr(h.cierre.texto, lang)}</p>
      <div class="tf-botones">
        <a class="tf-btn tf-btn--bronce" href={url(lang, 'contacto')}>{tr(home.nav.asesoria, lang)}</a>
        {wa && <a class="tf-btn tf-btn--borde-claro" href={wa} target="_blank" rel="noopener"><IconoLinea nombre="whatsapp" />{tr(h.cierre.whatsapp, lang)}</a>}
      </div>
    </div>
  </section>
</Base>

<script>
  const reducido = matchMedia('(prefers-reduced-motion: reduce)');

  // Carrusel de proyectos: scroll-snap con flechas y teclado.
  document.querySelectorAll<HTMLElement>('[data-carrusel]').forEach((c) => {
    const pista = c.querySelector<HTMLElement>('[data-pista]')!;
    const paso = () => (pista.querySelector('li')?.getBoundingClientRect().width ?? 300) + 24;
    const mover = (dir: number) => pista.scrollBy({ left: dir * paso(), behavior: reducido.matches ? 'auto' : 'smooth' });
    c.querySelectorAll<HTMLButtonElement>('[data-mover]').forEach((b) => b.addEventListener('click', () => mover(Number(b.dataset.mover))));
    pista.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); mover(1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); mover(-1); }
    });
    const estado = () => {
      const fin = pista.scrollWidth - pista.clientWidth - 2;
      c.querySelector<HTMLButtonElement>('[data-mover="-1"]')!.disabled = pista.scrollLeft <= 2;
      c.querySelector<HTMLButtonElement>('[data-mover="1"]')!.disabled = pista.scrollLeft >= fin;
    };
    pista.addEventListener('scroll', estado, { passive: true });
    addEventListener('resize', estado);
    estado();
  });
</script>
