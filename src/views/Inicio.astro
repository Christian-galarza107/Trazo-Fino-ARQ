---
import Base from '../layouts/Base.astro';
import Medio from '../components/Medio.astro';
import Titulo from '../components/Titulo.astro';
import Panorama from '../components/Panorama.astro';
import Obra from '../components/Obra.astro';
import Icono from '../components/Icono.astro';
import { modulos } from '../content/modulos';
import { portada } from '../content/portada';
import { imagen } from '../lib/medios';
import { proyectosVisibles } from '../lib/proyectos';
import { alternativas, m2, textos, tr, url, whatsapp } from '../lib/i18n';
import type { Idioma } from '../lib/tipos';
import { Picture } from 'astro:assets';

interface Props { lang: Idioma }
const { lang } = Astro.props;
const t = textos(lang);
const i = t.inicio;
const obras = proyectosVisibles().slice(0, 4);
const heroImg = imagen(portada.imagen);
const wa = whatsapp(t.contacto.wa.saludo);
const [mS, mM] = modulos;
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: t.modulos.titulo,
    itemListElement: modulos.map((m, n) => ({ '@type': 'ListItem', position: n + 1, url: new URL(url(lang, 'modulos', m.slug), Astro.site).href, name: tr(m.nombre, lang) })),
  },
];
---
<Base lang={lang} titulo={t.meta.inicio.titulo} descripcion={t.meta.inicio.descripcion} alternativas={alternativas('inicio')} sobreHero jsonld={jsonld}>
  <!-- 0. Portada -->
  <section class="hero" aria-labelledby="hero-titulo">
    {portada.video ? (
      <div class="hero__medio">
        <video autoplay muted loop playsinline preload="none" poster={portada.video.poster} data-video-hero aria-hidden="true">
          {portada.video.webm && <source src={portada.video.webm} type="video/webm" />}
          <source src={portada.video.mp4} type="video/mp4" />
        </video>
      </div>
    ) : heroImg ? (
      <div class="hero__medio">
        <Picture src={heroImg} alt={tr(portada.imagen?.alt, lang)} formats={['avif', 'webp']} widths={[800, 1280, 1920, 2560].filter((w) => w <= heroImg.width)} sizes="100vw" loading="eager" fetchpriority="high" />
      </div>
    ) : (
      <Panorama nota={`${t.aviso.imagenPendiente} · Video / fotografía de portada`} />
    )}
    <div class="contenedor hero__contenido">
      <div style="display:grid;gap:1.75rem">
        <p class="etiqueta" data-revelar>{i.hero.etiqueta}</p>
        <Titulo nivel={1} texto={i.hero.titulo} class="display hero__titulo" id="hero-titulo" />
      </div>
      <div class="hero__texto" data-revelar style="--d:4">
        <p>{i.hero.texto}</p>
        <div class="botones">
          <a class="boton boton--claro" href={url(lang, 'modulos')}>{t.cta.explorar} <Icono nombre="flecha" /></a>
          <a class="boton boton--linea-claro" href={url(lang, 'proyectos')}>{t.cta.proyectos}</a>
        </div>
      </div>
    </div>
    <span class="hero__bajar" aria-hidden="true">{i.hero.desplazar}</span>
  </section>

  <!-- 1. Presentación -->
  <section class="seccion" aria-labelledby="presentacion">
    <div class="contenedor reticula presentacion">
      <div class="presentacion__titulo" style="display:grid;gap:1.75rem">
        <p class="etiqueta" data-revelar>{i.presentacion.etiqueta}</p>
        <Titulo texto={i.presentacion.titulo} class="titulo-1" id="presentacion" />
      </div>
      <div class="presentacion__texto" data-revelar style="--d:2">
        <p class="bajada">{i.presentacion.texto}</p>
        <a class="enlace" href={url(lang, 'estudio')}>{t.nav.estudio} <span class="flecha">→</span></a>
      </div>
    </div>
  </section>

  <!-- 2. Introducción a las viviendas modulares -->
  <section class="seccion seccion--blanca" aria-labelledby="modular">
    <div class="contenedor reticula modular">
      <div class="modular__imagen">
        <Medio medio={portada.modular} lang={lang} ratio="4x5" rotulo={i.modular.etiqueta} tono="arena" barrido sizes="(min-width: 1024px) 55vw, 100vw" />
      </div>
      <div class="modular__texto">
        <p class="etiqueta" data-revelar>{i.modular.etiqueta}</p>
        <Titulo texto={i.modular.titulo} class="titulo-2" id="modular" />
        <p class="bajada" data-revelar>{i.modular.texto}</p>
      </div>
    </div>
  </section>

  <!-- 3. Módulos S y M (ancho proporcional a su superficie) -->
  <section class="seccion" aria-labelledby="modelos">
    <div class="contenedor">
      <div class="encabezado">
        <div style="display:grid;gap:1.5rem">
          <p class="etiqueta" data-revelar>{i.modelos.etiqueta}</p>
          <Titulo texto={i.modelos.titulo} class="titulo-1" id="modelos" />
        </div>
        <p class="bajada" data-revelar style="--d:2">{i.modelos.texto}</p>
      </div>
      <div class="duo">
        {[mS, mM].map((m, n) => (
          <article class="pieza" data-revelar style={`--d:${n}`}>
            <a class="pieza__medio" href={url(lang, 'modulos', m.slug)} aria-hidden="true" tabindex="-1">
              <Medio medio={m.medios.portada} lang={lang} ratio={n === 0 ? '4x5' : '3x2'} rotulo={`${tr(m.nombre, lang)} · ${t.ficha.exterior}`} tono={n === 0 ? 'arena' : 'piedra'} sizes={n === 0 ? '(min-width: 1024px) 33vw, 100vw' : '(min-width: 1024px) 66vw, 100vw'} />
            </a>
            <div class="pieza__datos">
              <h3 class="pieza__nombre"><a href={url(lang, 'modulos', m.slug)}>{tr(m.nombre, lang)}</a></h3>
              <span class="pieza__m2">{m2(m.superficie, lang)}</span>
              <p class="pieza__cat">{tr(m.categoria, lang)}</p>
              <div class="pieza__acciones">
                <a class="enlace" href={url(lang, 'modulos', m.slug)}>{t.cta.verModulo} <span class="flecha">→</span></a>
                <a class="enlace" href={`${url(lang, 'modulos', m.slug)}#consulta`}>{t.cta.cotizar}</a>
              </div>
            </div>
          </article>
        ))}
      </div>
      <div style="margin-top:clamp(3rem,2rem + 3vw,5rem)" data-revelar>
        <a class="boton boton--linea" href={`${url(lang, 'modulos')}#comparar`}>{t.cta.comparar}</a>
      </div>
    </div>
  </section>

  <!-- 4. Ventajas del enfoque -->
  <section class="seccion seccion--oscura" aria-labelledby="ventajas">
    <div class="contenedor">
      <div class="encabezado">
        <div style="display:grid;gap:1.5rem">
          <p class="etiqueta" data-revelar>{i.ventajas.etiqueta}</p>
          <Titulo texto={i.ventajas.titulo} class="titulo-1" id="ventajas" />
        </div>
      </div>
      <div class="ventajas">
        {i.ventajas.items.map((v, n) => (
          <div class="ventaja" data-revelar style={`--d:${n}`}>
            <span class="ventaja__n">0{n + 1}</span>
            <h3>{v.titulo}</h3>
            <p class="secundario">{v.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Trabajos del estudio -->
  <section class="seccion" aria-labelledby="obras">
    <div class="contenedor">
      <div class="encabezado">
        <div style="display:grid;gap:1.5rem">
          <p class="etiqueta" data-revelar>{i.estudio.etiqueta}</p>
          <Titulo texto={i.estudio.titulo} class="titulo-1" id="obras" />
        </div>
        <p class="bajada" data-revelar style="--d:2">{i.estudio.texto}</p>
      </div>
      {obras.length ? (
        <div class="mosaico">{obras.map((p, n) => <Obra proyecto={p} lang={lang} ratio={n % 2 ? '4x5' : '3x2'} demora={n % 2} />)}</div>
      ) : (
        <div class="vacio" data-revelar>
          <h3>{t.proyectos.vacioTitulo}</h3>
          <p>{t.proyectos.vacioTexto}</p>
          <a class="enlace" href={url(lang, 'contacto')}>{t.nav.contacto} <span class="flecha">→</span></a>
        </div>
      )}
      {obras.length > 0 && <div style="margin-top:4rem"><a class="boton boton--linea" href={url(lang, 'proyectos')}>{t.cta.proyectos}</a></div>}
    </div>
  </section>

  <!-- 6. Proceso comercial -->
  <section class="seccion seccion--arena" aria-labelledby="proceso">
    <div class="contenedor">
      <div class="encabezado">
        <div style="display:grid;gap:1.5rem">
          <p class="etiqueta" data-revelar>{i.proceso.etiqueta}</p>
          <Titulo texto={i.proceso.titulo} class="titulo-1" id="proceso" />
        </div>
      </div>
      <ol class="pasos">
        {i.proceso.pasos.map((p, n) => (
          <li class="paso" data-revelar style={`--d:${n % 2}`}>
            <span class="paso__n">0{n + 1}</span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 7. Llamado final -->
  <section class="seccion seccion--oscura" aria-labelledby="cierre">
    <div class="contenedor cierre">
      <Titulo texto={i.final.titulo} class="display" id="cierre" />
      <div style="display:grid;gap:1.75rem;--d:3" data-revelar>
        <p class="bajada">{i.final.texto}</p>
        <div class="botones">
          <a class="boton boton--claro" href={url(lang, 'contacto')}>{t.cta.cotizar}</a>
          {wa && <a class="boton boton--linea-claro" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" /> {t.cta.whatsapp}</a>}
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Video de portada: no se reproduce con ahorro de datos o movimiento reducido (queda el póster).
  const v = document.querySelector<HTMLVideoElement>('[data-video-hero]');
  if (v) {
    const ahorro = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    if (ahorro || matchMedia('(prefers-reduced-motion: reduce)').matches) {
      v.removeAttribute('autoplay');
    } else {
      v.preload = 'auto';
      v.play().catch(() => {});
    }
  }
</script>
