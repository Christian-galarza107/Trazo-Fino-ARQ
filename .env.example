# Copiar como .env para desarrollo local. En producción se cargan en
# Cloudflare Pages → Settings → Variables and Secrets. Ver docs/DESPLIEGUE.md

# Dominio definitivo
PUBLIC_SITE_URL=https://trazofinoarq.com

# false = sitio en preparación (noindex + robots bloqueado + aviso de revisión). true al lanzar.
PUBLIC_SITE_LAUNCHED=false

# Mostrar proyectos de DEMOSTRACIÓN (solo para revisar el diseño; nunca en producción).
PUBLIC_MOSTRAR_DEMOS=false

# --- Envío de consultas (Pages Function /api/consulta → Supabase) ---
# Valores en Supabase → Project Settings → API Keys. La clave publicable es pública por diseño;
# la protección la dan las políticas RLS (solo permite insertar consultas, nunca leerlas).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Recomendada: clave secreta SOLO del servidor (Cloudflare → Secret). Si existe, la función la usa
# en lugar de la publicable y permite aplicar la migración 0005 (ver docs/SEGURIDAD.md).
SUPABASE_SECRET_KEY=

# --- Anti-spam opcional (Cloudflare Turnstile) ---
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
