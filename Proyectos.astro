---
import Base from '../layouts/Base.astro';
import Titulo from '../components/Titulo.astro';
import Obra from '../components/Obra.astro';
import { proyectosVisibles } from '../lib/proyectos';
import { alternativas, textos, url } from '../lib/i18n';
import type { Idioma } from '../lib/tipos';
interface Props { lang: Idioma }
const { lang } = Astro.props;
const t = textos(lang);
const obras = proyectosVisibles();
---
<Base lang={lang} titulo={t.meta.proyectos.titulo} descripcion={t.meta.proyectos.descripcion} alternativas={alternativas('proyectos')} actual="proyectos">
  <section class="contenedor" style="padding-block:clamp(3rem,2rem + 6vw,8rem) clamp(3rem,2rem + 4vw,6rem)">
    <div class="encabezado" style="margin:0">
      <div style="display:grid;gap:1.5rem">
        <p class="etiqueta" data-revelar>{t.proyectos.etiqueta}</p>
        <Titulo nivel={1} texto={t.proyectos.titulo} class="display" />
      </div>
      <p class="bajada" data-revelar style="--d:3">{t.proyectos.texto}</p>
    </div>
  </section>
  <section class="contenedor" style="padding-bottom:var(--seccion)">
    {obras.length ? (
      <div class="mosaico">{obras.map((p, n) => <Obra proyecto={p} lang={lang} ratio={n % 2 ? '4x5' : '3x2'} demora={n % 2} />)}</div>
    ) : (
      <div class="vacio" data-revelar>
        <h2 class="titulo-2" style="font-weight:300">{t.proyectos.vacioTitulo}</h2>
        <p>{t.proyectos.vacioTexto}</p>
        <a class="enlace" href={url(lang, 'contacto')}>{t.nav.contacto} <span class="flecha">→</span></a>
      </div>
    )}
  </section>
</Base>
