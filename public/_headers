# Cabeceras de seguridad para los archivos estáticos de Cloudflare Pages.
# La política (marcador en la línea Content-Security-Policy) se completa en el build (scripts/seguridad-csp.mjs) con la política y los hashes reales.
# Las respuestas de Pages Functions (/api/*) definen sus propias cabeceras en el código.

/*
  Content-Security-Policy: __CSP__
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/marca/*
  Cache-Control: public, max-age=604800

/media/*
  Cache-Control: public, max-age=2592000

# Los despliegues de vista previa (*.pages.dev) no deben indexarse
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow
